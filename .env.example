UPSTAGE_API_KEY=up_xxx
UPSTAGE_AGENT_ID=agt_PNZaixnk4TZxkDg5muEJQi

# 없으면 .data/ 파일 저장소로 자동 전환된다(로컬 개발용).
# NEXT_PUBLIC_ 접두사를 쓰지 않는다 — 서버에서만 부른다.
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=xxx

# 보호자 세션 서명 키. 16자 이상 난수. 없으면 보호자 화면이 열리지 않는다.
AUTH_SECRET=xxx

# 어르신 음성(ElevenLabs). 없으면 기기 내장 TTS 로 폴백한다. 서버 전용.
ELEVENLABS_API_KEY=xxx

# 에이전트 워커(scripts/agent-worker.ts)가 서버에 자신을 증명하는 비밀. 서버와 워커 양쪽에 같은 값.
AGENT_SECRET=xxx
